# Copy this file to .env and fill in what you need.  (cp .env.example .env)
# Never commit your real .env: it is in .gitignore.

# --- LLM -------------------------------------------------------------------
# ollama (local, free) | groq | openrouter | huggingface
LLM_PROVIDER=ollama
# Optional: model name. Must support tool calling. Defaults:
#   ollama      qwen2.5:7b
#   groq        llama-3.3-70b-versatile
#   openrouter  meta-llama/llama-3.3-70b-instruct
#   huggingface meta-llama/Llama-3.3-70B-Instruct
# LLM_MODEL=
# LLM_TEMPERATURE=0.1

# Ollama (only if it is not on localhost; from Docker use http://host.docker.internal:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# API keys (only the one for your provider)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACEHUB_API_TOKEN=

# --- Alfred (MCP agent) ----------------------------------------------------
# rag_primeiro (RAG always first) | livre (the LLM decides every tool)
MODO_AGENTE=rag_primeiro
# USAR_MCP=0 restores the D2 behaviour (fixed RAG, no MCP tools)
USAR_MCP=1
# Max seconds per Alfred answer
# AGENTE_TIMEOUT=180
# Full log of every MCP call (arguments + result); empty = off
# MCP_LOG_FILE=logs/mcp_tools.log

# --- Languages ---------------------------------------------------------------
# The web app has a PT/EN switch. English uses the English rule-based Batman,
# English Wikipedia for the RAG (rag/pdffiles_en/, rag/iln_batman_en/) and Alfred in English.
# Language of the terminal chat (python agente_hibrido.py): pt | en
# IDIOMA=pt
# Start the English MCP server at launch (1) or only on the first English question (0)
# PRELOAD_EN=1

# --- Web server ------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8001
# Messages per minute per IP (0 = unlimited)
# RATE_LIMIT_PER_MIN=20
# Behind a reverse proxy (Hugging Face Spaces, nginx...): use X-Forwarded-For
# TRUST_PROXY=0

# --- Models (advanced) -----------------------------------------------------
# Changing EMBEDDING_MODEL requires deleting rag/iln_batman/ to rebuild the DB
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# ROUTER_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# RAG_DB_DIR=rag/iln_batman
# RAG_DB_DIR_EN=rag/iln_batman_en
